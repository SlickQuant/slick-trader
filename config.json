{
  "brokers": [
    {
      "enabled": true,
      "market_data": {
        "enabled": true,
        "websocket_url": "ws://localhost:5000"
      },
      "name": "coinbase",
      "order": {
        "enabled": true,
        "rest_url": "http://localhost:4000",
        "websocket_url": "ws://localhost:4001"
      }
    }
  ],
  "enable_web_server": true,
  "ladder_config": {
    "default_qty": 0.01,
    "default_strategy_id": "SimpleStrategyPlugin",
    "per_instrument": {
      "BTC-USD": {
        "default_qty": 0.001
      },
      "ETH-USD": {
        "default_qty": 0.01
      }
    }
  },
  "log_file_path": "logs/slick_trader.log",
  "log_level": 1,
  "md_queue_size": 16777216,
  "order_reply_queue_size": 1048576,
  "order_request_queue_size": 1048576,
  "strategies": [
    {
      "enabled": true,
      "name": "SimpleStrategyPlugin",
      "parameters": {
        "log_orderbook": false,
        "log_quotes": false,
        "log_trades": true,
        "min_spread_bps": 5
      },
      "risk_limits": {
        "instruments": {
          "BTC-USD": {
            "max_order_value": 20000,
            "max_position_size": 0.5
          },
          "ETH-USD": {
            "max_order_value": 0.0,
            "max_position_size": 0
          }
        },
        "max_loss_per_strategy": -2000.0,
        "max_order_value": 100000.0,
        "max_orders_per_second": 5,
        "max_position_size": 1
      }
    },
    {
      "enabled": true,
      "name": "MarketMaker",
      "parameters": {
        "//fair_value_mode": "NLEVEL_WMID",
        "broker": "COINBASE",
        "ema_fast_periods": 3000,
        "ema_slow_periods": 18000,
        "fair_value_mode": "WEIGHTED_MID",
        "imbalance_sensitivity": 0.5,
        "instrument": "BTC-USD",
        "inventory_skew_factor": 0.3,
        "max_inventory": 0.01,
        "nlevel_depth": 20,
        "order_size": 0.0005,
        "refresh_threshold_bps": 0.001,
        "spread_bps": 1,
        "trend_sensitivity": 0.5
      },
      "risk_limits": {
        "max_loss_per_strategy": -200.0,
        "max_order_value": 10000.0,
        "max_orders_per_second": 10,
        "max_position_size": 0.05
      }
    }
  ],
  "strategy_plugins_folder": "build/strategies/Debug",
  "web_server_cors": true,
  "web_server_port": 3000,
  "web_server_static_path": "web/static"
}